# Copy to .env.local and edit. Restart / rebuild after changes.
# Only NEXT_PUBLIC_* values are available in the browser.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production (VPS) example:
# NEXT_PUBLIC_SITE_URL=https://freebackgroundremoverai.com
# NEXT_PUBLIC_API_URL=https://freebackgroundremoverai.com
# API_INTERNAL_URL=http://127.0.0.1:8000
#   ↑ required on VPS so /blog-media and /uploads rewrite to FastAPI (not a loop)

# Contact emails (shown on Contact / Privacy / Terms)
NEXT_PUBLIC_CONTACT_SUPPORT_EMAIL=support@freebackgroundremoverai.com
NEXT_PUBLIC_CONTACT_GENERAL_EMAIL=hello@freebackgroundremoverai.com
NEXT_PUBLIC_CONTACT_PRIVACY_EMAIL=privacy@freebackgroundremoverai.com
NEXT_PUBLIC_CONTACT_RESPONSE_TIME=Within 24–48 hours on business days
NEXT_PUBLIC_CONTACT_HOURS=Monday – Friday, 9:00 AM – 6:00 PM
NEXT_PUBLIC_CONTACT_LOCATION=Remote-first team · Worldwide support

# Social profiles — set your real URLs.
# To hide a network, set it to empty: NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/
