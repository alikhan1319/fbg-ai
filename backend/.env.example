# Copy this file to .env and edit once for local or production.

# Server
HOST=0.0.0.0
PORT=8000

# CORS — comma-separated frontend URLs allowed to call this API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Segmentation stack (SAM2 → BiRefNet → PyMatting)
# SEG_DEVICE=cuda
# SEG_MAX_EDGE=1024
# SEG_BENCH=1
# SEG_DISABLE_SAM2=0
# SEG_DISABLE_BIREFNET=0
# SEG_DISABLE_MATTING=auto
#   auto = off on CPU (prevents multi-minute hangs), on when CUDA is available
#   1 = always off, 0 = always on
# BIREFNET_REMBG_MODEL=isnet-general-use
#   CPU default is isnet-general-use; set birefnet-general for higher quality (slower)
# MATTING_FG=240
# MATTING_BG=10
# MATTING_ERODE=10
# MATTING_MAX_EDGE=1280

# MySQL CMS database (defaults shown — empty password for local root)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=fbgai

# Admin session security (users are stored in MySQL admin_users table)
ADMIN_SESSION_DAYS=7
ADMIN_COOKIE_SECURE=false
ADMIN_MAX_LOGIN_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_SECONDS=900

# Optional: auto-create first admin when admin_users table is empty (then remove password from .env)
# ADMIN_BOOTSTRAP_EMAIL=you@example.com
# ADMIN_BOOTSTRAP_PASSWORD=change-me-now
# ADMIN_BOOTSTRAP_NAME=Site Admin

# Public site URL (used in newsletter emails)
SITE_URL=http://localhost:3000
SITE_NAME=Free Background Remover AI

# Newsletter email (SMTP) — required to notify subscribers when a blog post is published
NEWSLETTER_NOTIFY_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Free Background Remover AI
